#
# Win32 makefile (MinGW + SDL2). Not tested by the CI build.
#

CC:=gcc
CXX:=g++
PREFIX=../win32/
SUFFIX=.exe
LIBS=-lmingw32 -lSDL2main -lSDL2 -lwinmm -limm32 -static-libstdc++ -static-libgcc
RM=	-del

include makefile.common

$(PREFIX)goattrk2$(SUFFIX): $(GOATTRK2OBJ)
	windres goattrk2.rc goaticon.o
	$(CXX) -o $@ $^ goaticon.o -mwindows $(LIBS)
	strip $@
